    "prompt": "Analyze frequently purchased product combinations to identify common bundles in the sales data. Compare co-purchase patterns across store locations and seasonal time periods to highlight location- and season-specific buying behavior.",
    "title": "Co-Purchase Bundle Analysis",
    "summary": "Analyze frequently purchased product combinations to identify common bundles in the sales data. Compare co-purchase patterns across store locations and seasonal periods to reveal location- and season-specific buying behavior.",
    "timestamp": "2026-09-29 02:02:58",
    "executed_sql_queries": [
        "SELECT EXTRACT(YEAR FROM o.order_date) AS order_year, COUNT(DISTINCT o.order_id) AS eligible_order_count, COUNT(oi.order_item_id) AS line_item_count FROM retail.orders o JOIN retail.order_items oi ON o.order_id = oi.order_id WHERE EXTRACT(YEAR FROM o.order_date) IN (2020, 2021, 2022, 2023, 2024, 2025, 2026) GROUP BY EXTRACT(YEAR FROM o.order_date) ORDER BY order_year;",
        "WITH eligible_orders AS (\n  SELECT\n    o.order_id,\n    o.order_date,\n    EXTRACT(YEAR FROM o.order_date)::int AS order_year,\n    CASE\n      WHEN EXTRACT(MONTH FROM o.order_date) IN (12, 1, 2) THEN 'Winter'\n      WHEN EXTRACT(MONTH FROM o.order_date) IN (3, 4, 5) THEN 'Spring'\n      WHEN EXTRACT(MONTH FROM o.order_date) IN (6, 7, 8) THEN 'Summer'\n      ELSE 'Fall'\n    END AS season\n  FROM retail.orders o\n  WHERE EXTRACT(YEAR FROM o.order_date) BETWEEN 2020 AND 2026\n), seasonal_order_counts AS (\n  SELECT order_year, season, COUNT(*) AS order_count\n  FROM eligible_orders\n  GROUP BY order_year, season\n), seasonal_item_counts AS (\n  SELECT eo.order_year, eo.season, COUNT(*) AS line_item_count, COUNT(DISTINCT eo.order_id) AS orders_with_items\n  FROM eligible_orders eo\n  JOIN retail.order_items oi ON eo.order_id = oi.order_id\n  GROUP BY eo.order_year, eo.season\n)\nSELECT\n  soc.order_year,\n  soc.season,\n  soc.order_count,\n  sic.orders_with_items,\n  sic.line_item_count\nFROM seasonal_order_counts soc\nJOIN seasonal_item_counts sic\n  ON soc.order_year = sic.order_year\n AND soc.season = sic.season\nORDER BY soc.order_year, soc.season;",
        "WITH eligible_orders AS (\n  SELECT\n    o.order_id,\n    s.store_name,\n    o.order_date,\n    EXTRACT(YEAR FROM o.order_date)::int AS order_year,\n    CASE\n      WHEN EXTRACT(MONTH FROM o.order_date) IN (12,1,2) THEN 'Winter'\n      WHEN EXTRACT(MONTH FROM o.order_date) IN (3,4,5) THEN 'Spring'\n      WHEN EXTRACT(MONTH FROM o.order_date) IN (6,7,8) THEN 'Summer'\n      ELSE 'Fall'\n    END AS season\n  FROM retail.orders o\n  JOIN retail.stores s ON s.store_id = o.store_id\n  WHERE EXTRACT(YEAR FROM o.order_date) BETWEEN 2020 AND 2023\n), order_item_products AS (\n  SELECT DISTINCT\n    eo.order_id,\n    eo.store_name,\n    eo.order_year,\n    eo.season,\n    oi.product_id,\n    p.product_name\n  FROM eligible_orders eo\n  JOIN retail.order_items oi ON oi.order_id = eo.order_id\n  JOIN retail.products p ON p.product_id = oi.product_id\n), order_level_counts AS (\n  SELECT\n    store_name,\n    season,\n    order_year,\n    COUNT(DISTINCT order_id) AS order_count,\n    COUNT(DISTINCT product_id) AS distinct_product_count\n  FROM order_item_products\n  GROUP BY 1,2,3\n), pair_counts AS (\n  SELECT\n    a.store_name,\n    a.season,\n    a.order_year,\n    a.order_id,\n    LEAST(a.product_name, b.product_name) AS product_name_1,\n    GREATEST(a.product_name, b.product_name) AS product_name_2\n  FROM order_item_products a\n  JOIN order_item_products b\n    ON a.order_id = b.order_id\n   AND a.store_name = b.store_name\n   AND a.season = b.season\n   AND a.order_year = b.order_year\n   AND a.product_id < b.product_id\n), pair_agg AS (\n  SELECT\n    store_name,\n    season,\n    order_year,\n    product_name_1,\n    product_name_2,\n    COUNT(DISTINCT order_id) AS co_purchase_frequency,\n    ROW_NUMBER() OVER (\n      PARTITION BY store_name, season, order_year\n      ORDER BY COUNT(DISTINCT order_id) DESC, product_name_1, product_name_2\n    ) AS bundle_rank\n  FROM pair_counts\n  GROUP BY 1,2,3,4,5\n), top_pair AS (\n  SELECT *\n  FROM pair_agg\n  WHERE bundle_rank = 1\n)\nSELECT\n  olc.store_name,\n  olc.season,\n  olc.order_year,\n  olc.order_count,\n  olc.distinct_product_count,\n  tp.product_name_1,\n  tp.product_name_2,\n  tp.co_purchase_frequency,\n  ROUND(tp.co_purchase_frequency::numeric / NULLIF(olc.order_count,0), 4) AS co_purchase_share_of_orders,\n  tp.bundle_rank\nFROM order_level_counts olc\nLEFT JOIN top_pair tp\n  ON tp.store_name = olc.store_name\n AND tp.season = olc.season\n AND tp.order_year = olc.order_year\nORDER BY olc.store_name, olc.order_year, olc.season;",
        "WITH eligible_orders AS (\n  SELECT o.order_id,\n         s.store_name,\n         EXTRACT(YEAR FROM o.order_date)::int AS order_year,\n         CASE\n           WHEN EXTRACT(MONTH FROM o.order_date) IN (12,1,2) THEN 'Winter'\n           WHEN EXTRACT(MONTH FROM o.order_date) IN (3,4,5) THEN 'Spring'\n           WHEN EXTRACT(MONTH FROM o.order_date) IN (6,7,8) THEN 'Summer'\n           ELSE 'Fall'\n         END AS season\n  FROM retail.orders o\n  JOIN retail.stores s ON s.store_id = o.store_id\n  WHERE EXTRACT(YEAR FROM o.order_date) BETWEEN 2024 AND 2026\n), order_level AS (\n  SELECT eo.store_name, eo.order_year, eo.season, eo.order_id,\n         COUNT(DISTINCT oi.product_id) AS distinct_product_count\n  FROM eligible_orders eo\n  JOIN retail.order_items oi ON oi.order_id = eo.order_id\n  GROUP BY eo.store_name, eo.order_year, eo.season, eo.order_id\n), summary AS (\n  SELECT store_name, order_year, season,\n         COUNT(*) AS order_count,\n         ROUND(AVG(distinct_product_count)::numeric, 2) AS distinct_product_count\n  FROM order_level\n  GROUP BY store_name, order_year, season\n), pair_counts AS (\n  SELECT eo.store_name, eo.order_year, eo.season,\n         p1.product_name AS product_name_1,\n         p2.product_name AS product_name_2,\n         COUNT(DISTINCT eo.order_id) AS co_purchase_frequency,\n         COUNT(DISTINCT eo.order_id)::numeric / NULLIF(s.order_count, 0) AS co_purchase_share_of_orders,\n         ROW_NUMBER() OVER (\n           PARTITION BY eo.store_name, eo.order_year, eo.season\n           ORDER BY COUNT(DISTINCT eo.order_id) DESC, p1.product_name, p2.product_name\n         ) AS bundle_rank\n  FROM eligible_orders eo\n  JOIN retail.order_items a ON a.order_id = eo.order_id\n  JOIN retail.order_items b ON b.order_id = eo.order_id AND a.product_id < b.product_id\n  JOIN retail.products p1 ON p1.product_id = a.product_id\n  JOIN retail.products p2 ON p2.product_id = b.product_id\n  JOIN summary s ON s.store_name = eo.store_name AND s.order_year = eo.order_year AND s.season = eo.season\n  GROUP BY eo.store_name, eo.order_year, eo.season, p1.product_name, p2.product_name, s.order_count\n), top_bundle AS (\n  SELECT * FROM pair_counts WHERE bundle_rank = 1\n)\nSELECT s.store_name, s.season, s.order_year, s.order_count, s.distinct_product_count,\n       tb.product_name_1, tb.product_name_2, tb.co_purchase_frequency,\n       ROUND(tb.co_purchase_share_of_orders, 4) AS co_purchase_share_of_orders,\n       tb.bundle_rank\nFROM summary s\nLEFT JOIN top_bundle tb\n  ON tb.store_name = s.store_name AND tb.order_year = s.order_year AND tb.season = s.season\nORDER BY s.store_name, s.order_year, s.season;"
    ],
