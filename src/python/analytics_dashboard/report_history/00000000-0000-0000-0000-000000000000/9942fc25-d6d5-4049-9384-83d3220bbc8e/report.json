    "executed_sql_queries": [
        "SELECT EXTRACT(YEAR FROM o.order_date) AS year,\n       EXTRACT(MONTH FROM o.order_date) AS month,\n       SUM(oi.total_amount) AS total_sales,\n       COUNT(DISTINCT o.order_id) AS order_count,\n       SUM(oi.quantity) AS units_sold,\n       SUM(oi.total_amount) / NULLIF(COUNT(DISTINCT o.order_id), 0) AS average_order_value\nFROM retail.orders o\nJOIN retail.order_items oi\n  ON o.order_id = oi.order_id\nWHERE o.order_date BETWEEN DATE '2022-01-01' AND DATE '2024-12-31'\nGROUP BY EXTRACT(YEAR FROM o.order_date), EXTRACT(MONTH FROM o.order_date)\nORDER BY year, month;",
        "WITH yearly_sales AS (\n  SELECT\n    EXTRACT(YEAR FROM o.order_date)::int AS year,\n    SUM(oi.total_amount) AS total_sales\n  FROM retail.orders o\n  JOIN retail.order_items oi\n    ON o.order_id = oi.order_id\n  WHERE o.order_date BETWEEN DATE '2020-01-01' AND DATE '2026-12-31'\n  GROUP BY 1\n)\nSELECT\n  year,\n  total_sales,\n  total_sales - LAG(total_sales) OVER (ORDER BY year) AS yoy_absolute_change,\n  CASE\n    WHEN LAG(total_sales) OVER (ORDER BY year) IS NULL OR LAG(total_sales) OVER (ORDER BY year) = 0 THEN NULL\n    ELSE ROUND(((total_sales - LAG(total_sales) OVER (ORDER BY year)) / LAG(total_sales) OVER (ORDER BY year)) * 100.0, 2)\n  END AS yoy_percent_change\nFROM yearly_sales\nORDER BY year;",
        "WITH yearly_store_sales AS (\n  SELECT\n    o.store_id,\n    s.store_name,\n    EXTRACT(YEAR FROM o.order_date)::int AS year,\n    SUM(oi.total_amount) AS total_sales\n  FROM retail.order_items oi\n  JOIN retail.orders o\n    ON oi.order_id = o.order_id\n  JOIN retail.stores s\n    ON o.store_id = s.store_id\n  WHERE o.order_date >= DATE '2022-01-01'\n    AND o.order_date < DATE '2025-01-01'\n  GROUP BY o.store_id, s.store_name, EXTRACT(YEAR FROM o.order_date)\n), pivoted AS (\n  SELECT\n    store_id,\n    store_name,\n    SUM(CASE WHEN year = 2022 THEN total_sales ELSE 0 END) AS sales_2022,\n    SUM(CASE WHEN year = 2023 THEN total_sales ELSE 0 END) AS sales_2023,\n    SUM(CASE WHEN year = 2024 THEN total_sales ELSE 0 END) AS sales_2024\n  FROM yearly_store_sales\n  GROUP BY store_id, store_name\n)\nSELECT\n  store_id,\n  store_name,\n  sales_2022,\n  sales_2023,\n  sales_2024,\n  (sales_2023 - sales_2022) AS yoy_abs_change_2023_vs_2022,\n  CASE WHEN sales_2022 = 0 THEN NULL ELSE ROUND(((sales_2023 - sales_2022) / sales_2022) * 100.0, 2) END AS yoy_pct_change_2023_vs_2022,\n  (sales_2024 - sales_2023) AS yoy_abs_change_2024_vs_2023,\n  CASE WHEN sales_2023 = 0 THEN NULL ELSE ROUND(((sales_2024 - sales_2023) / sales_2023) * 100.0, 2) END AS yoy_pct_change_2024_vs_2023\nFROM pivoted\nORDER BY store_name;",
        "WITH category_sales AS (\n    SELECT\n        c.category_id,\n        c.category_name,\n        pt.type_name AS product_type,\n        EXTRACT(YEAR FROM oi.order_id::text::date) AS year,\n        SUM(oi.total_amount) AS total_sales\n    FROM retail.order_items oi\n    JOIN retail.products p\n        ON oi.product_id = p.product_id\n    JOIN retail.categories c\n        ON p.category_id = c.category_id\n    JOIN retail.product_types pt\n        ON p.type_id = pt.type_id\n    WHERE oi.order_id IS NOT NULL\n      AND oi.order_id IN (\n          SELECT o.order_id\n          FROM retail.orders o\n          WHERE o.order_date >= DATE '2022-01-01'\n            AND o.order_date < DATE '2025-01-01'\n      )\n    GROUP BY c.category_id, c.category_name, pt.type_name, EXTRACT(YEAR FROM oi.order_id::text::date)\n)\nSELECT\n    category_id,\n    category_name,\n    product_type,\n    year,\n    total_sales,\n    total_sales - LAG(total_sales) OVER (\n        PARTITION BY category_id, category_name, product_type\n        ORDER BY year\n    ) AS yoy_abs_change,\n    CASE\n        WHEN LAG(total_sales) OVER (\n            PARTITION BY category_id, category_name, product_type\n            ORDER BY year\n        ) IS NULL OR LAG(total_sales) OVER (\n            PARTITION BY category_id, category_name, product_type\n            ORDER BY year\n        ) = 0 THEN NULL\n        ELSE (total_sales - LAG(total_sales) OVER (\n            PARTITION BY category_id, category_name, product_type\n            ORDER BY year\n        )) / LAG(total_sales) OVER (\n            PARTITION BY category_id, category_name, product_type\n            ORDER BY year\n        ) * 100.0\n    END AS yoy_pct_change\nFROM category_sales\nORDER BY category_name, product_type, year;",
        "WITH category_year_sales AS (\n    SELECT\n        c.category_id,\n        c.category_name,\n        EXTRACT(YEAR FROM o.order_date)::int AS year,\n        SUM(oi.total_amount) AS total_sales\n    FROM retail.order_items oi\n    JOIN retail.orders o\n        ON oi.order_id = o.order_id\n    JOIN retail.products p\n        ON oi.product_id = p.product_id\n    JOIN retail.categories c\n        ON p.category_id = c.category_id\n    WHERE o.order_date >= DATE '2022-01-01'\n      AND o.order_date < DATE '2025-01-01'\n    GROUP BY c.category_id, c.category_name, EXTRACT(YEAR FROM o.order_date)::int\n), yoy AS (\n    SELECT\n        category_id,\n        category_name,\n        year,\n        total_sales,\n        LAG(total_sales) OVER (PARTITION BY category_id ORDER BY year) AS prev_year_sales,\n        LEAD(total_sales) OVER (PARTITION BY category_id ORDER BY year) AS next_year_sales\n    FROM category_year_sales\n)\nSELECT\n    category_id,\n    category_name,\n    year,\n    total_sales,\n    prev_year_sales,\n    ROUND(total_sales - prev_year_sales, 2) AS yoy_abs_change,\n    ROUND((total_sales - prev_year_sales) / NULLIF(prev_year_sales, 0) * 100.0, 2) AS yoy_pct_change,\n    next_year_sales,\n    ROUND(next_year_sales - total_sales, 2) AS next_yoy_abs_change,\n    ROUND((next_year_sales - total_sales) / NULLIF(total_sales, 0) * 100.0, 2) AS next_yoy_pct_change\nFROM yoy\nORDER BY category_name, year;"
    ],
