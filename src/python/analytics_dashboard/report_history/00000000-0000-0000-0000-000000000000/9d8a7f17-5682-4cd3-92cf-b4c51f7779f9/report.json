{
    "report_id": "9d8a7f17-5682-4cd3-92cf-b4c51f7779f9",
    "user_id": "00000000-0000-0000-0000-000000000000",
    "prompt": "make report on sales",
    "title": "Sales Report",
    "summary": "A concise report on sales performance, trends, and key metrics. It can include revenue, units sold, growth, and notable observations.",
    "timestamp": "2026-10-01 05:36:11",
    "executed_sql_queries": [
        "WITH order_totals AS (\n  SELECT\n    o.order_id,\n    o.order_date,\n    SUM(oi.total_amount) AS order_revenue\n  FROM retail.orders o\n  JOIN retail.order_items oi\n    ON o.order_id = oi.order_id\n  GROUP BY o.order_id, o.order_date\n)\nSELECT\n  DATE_TRUNC('month', order_date)::date AS month,\n  SUM(order_revenue) AS monthly_revenue,\n  COUNT(DISTINCT order_id) AS monthly_order_count\nFROM order_totals\nGROUP BY 1\nORDER BY 1",
        "SELECT\n  s.store_name,\n  SUM(oi.total_amount) AS store_revenue,\n  COUNT(DISTINCT o.order_id) AS store_order_count,\n  SUM(oi.quantity) AS store_units_sold,\n  AVG(COALESCE(oi.discount_percent, 0)) AS average_discount\nFROM retail.orders o\nJOIN retail.order_items oi\n  ON o.order_id = oi.order_id\n AND o.store_id = oi.store_id\nJOIN retail.stores s\n  ON o.store_id = s.store_id\nWHERE s.store_name IN (\n  'Zava Retail Seattle',\n  'Zava Retail Bellevue',\n  'Zava Retail Tacoma',\n  'Zava Retail Spokane',\n  'Zava Retail Everett',\n  'Zava Retail Redmond',\n  'Zava Retail Kirkland',\n  'Zava Retail Online'\n)\nGROUP BY s.store_name\nORDER BY s.store_name;",
        "WITH product_sales AS (\n    SELECT\n        p.category_id,\n        c.category_name,\n        p.type_id,\n        pt.type_name,\n        p.product_id,\n        p.product_name,\n        SUM(oi.total_amount) AS product_revenue,\n        SUM(oi.quantity) AS product_units_sold,\n        CASE WHEN SUM(oi.quantity) = 0 THEN NULL ELSE SUM(oi.total_amount) / SUM(oi.quantity) END AS average_selling_price\n    FROM retail.order_items oi\n    JOIN retail.products p\n      ON oi.product_id = p.product_id\n    JOIN retail.categories c\n      ON p.category_id = c.category_id\n    JOIN retail.product_types pt\n      ON p.type_id = pt.type_id\n    GROUP BY\n        p.category_id, c.category_name,\n        p.type_id, pt.type_name,\n        p.product_id, p.product_name\n)\nSELECT\n    category_name,\n    SUM(product_revenue) AS category_revenue,\n    SUM(product_units_sold) AS category_units_sold,\n    type_name AS product_type,\n    SUM(product_revenue) OVER (PARTITION BY type_name) AS product_type_revenue,\n    SUM(product_units_sold) OVER (PARTITION BY type_name) AS product_type_units_sold,\n    product_name,\n    product_revenue,\n    product_units_sold,\n    average_selling_price\nFROM product_sales\nORDER BY category_name, product_type, product_revenue DESC, product_units_sold DESC;",
        "SELECT COUNT(*) AS inventory_rows, COUNT(DISTINCT store_id) AS stores_with_inventory, COUNT(DISTINCT product_id) AS products_with_inventory, SUM(stock_level) AS total_inventory_on_hand, SUM(CASE WHEN stock_level = 0 THEN 1 ELSE 0 END) AS stockout_rows FROM retail.inventory;",
        "SELECT s.store_name, s.is_online, SUM(i.stock_level) AS inventory_on_hand, COUNT(*) AS inventory_rows, COUNT(DISTINCT i.product_id) AS products_with_inventory, SUM(CASE WHEN i.stock_level = 0 THEN 1 ELSE 0 END) AS stockout_indicator FROM retail.inventory i JOIN retail.stores s ON i.store_id = s.store_id GROUP BY s.store_name, s.is_online ORDER BY inventory_on_hand DESC;",
        "SELECT p.product_id, p.product_name, SUM(i.stock_level) AS inventory_on_hand, COUNT(*) AS inventory_rows, SUM(CASE WHEN i.stock_level = 0 THEN 1 ELSE 0 END) AS stockout_indicator FROM retail.inventory i JOIN retail.products p ON i.product_id = p.product_id GROUP BY p.product_id, p.product_name ORDER BY inventory_on_hand DESC, p.product_name ASC LIMIT 20;"
    ],
    "components": [
        {
            "type": "text",
            "content": "<p><strong>Executive sales summary</strong> for the 8 accessible stores shows <strong>$44.0M</strong> in revenue across <strong>184,000 orders</strong>, with an <strong>average order value of $239.13</strong>.</p><ul><li><strong>Top revenue stores:</strong> Online led with <strong>$12.99M</strong> and <strong>54,987 orders</strong>, closely followed by Seattle at <strong>$12.88M</strong> and <strong>54,931 orders</strong>. Bellevue ranked third with <strong>$8.61M</strong> from <strong>36,917 orders</strong>.</li><li><strong>Lower-volume stores:</strong> Tacoma generated <strong>$6.26M</strong> from <strong>26,327 orders</strong>, while Spokane, Everett, Redmond, and Kirkland contributed <strong>$2.40M</strong>, <strong>$1.55M</strong>, <strong>$1.21M</strong>, and <strong>$0.72M</strong> respectively.</li><li><strong>Sales mix insight:</strong> Online + Seattle account for <strong>$25.86M</strong>, or about <strong>58.8%</strong> of total revenue, indicating strong concentration in the two largest channels.</li><li><strong>Trend:</strong> Monthly revenue has grown materially over time, rising from roughly <strong>$442k</strong> in Jan 2020 to <strong>$686k</strong> in Dec 2026, with a peak of <strong>$763,329.92</strong> in Feb 2026.</li><li><strong>Operational note:</strong> Average discount levels are tightly clustered across stores, ranging from <strong>2.2161%</strong> in Spokane to <strong>2.3421%</strong> in Kirkland, suggesting consistent pricing discipline.</li></ul><p><em>Macro view:</em> performance is being driven primarily by the Online and Seattle stores, while the smaller locations provide incremental volume and geographic coverage.</p>",
            "id": 1.0
        },
